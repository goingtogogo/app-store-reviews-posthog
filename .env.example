# App Store Connect API credentials
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY=""
ASC_APP_ID=

# PostHog project API key
# Generate at https://eu.posthog.com/settings/project#variables
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Polling
POLL_INTERVAL_MS=3600000

# Days of history to pull on first run (before the watermark exists).
# Set to 0 to fetch ALL reviews ever (no cutoff).
BACKFILL_DAYS=90
WATERMARK_PATH=./data/watermark.json

# Comma-separated ISO-2 country codes to poll ratings for.
RATINGS_COUNTRIES=us,cn,jp,gb,de,fr,kr,ca,au,ru,br,mx,in,it,es,mn,tw,hk,nl,tr

# Server
PORT=3000
NODE_ENV=development
